{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Substrate Census",
  "version": "0.1.0",
  "identifier": "com.gosubstrate.census",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Substrate Census",
        "width": 520,
        "height": 540,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Substrate",
    "copyright": "© 2026 Substrate",
    "homepage": "https://gosubstrate.com/census/",
    "category": "Utility",
    "shortDescription": "The Substrate AI software census, one click",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
